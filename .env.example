# LiveUAmap's official API key. Configure this in Vercel; never expose it to Vite/client code.
LIVEUAMAP_API_KEY=

# Private image-geolocation sidecar. Plain HTTP is accepted only for loopback URLs.
OSINT_API_URL=http://127.0.0.1:3000/api/geolocate
# Optional shared secret; set the same strong random value in the osint service.
OSINT_API_SECRET=

# Optional browser-safe URL for the standalone OSINT pin feed.
# Example for local development: http://localhost:3001/pins
VITE_OSINT_PINS_URL=
